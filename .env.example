# Copy to .env and fill in. .env is git-ignored.

# Contact address advertised in the HTTP User-Agent of every request the
# collectors make. Be a good citizen: use a real, monitored address of the
# research group. DO NOT put a private personal address here.
CONTACT_EMAIL=rotavirus-research@example.org

# Copernicus Climate Data Store API key (optional; only needed for the
# `era5` extra / ERA5-Land reanalysis collector). Format: "<uid>:<apikey>".
# See https://cds.climate.copernicus.eu/how-to-api
CDS_API_KEY=

# Optional outbound proxy (leave blank if not needed).
HTTP_PROXY=
HTTPS_PROXY=
