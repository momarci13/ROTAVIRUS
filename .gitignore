# --- Data: raw / intermediate / processed are reproducible, NOT tracked ---
data/raw/
data/intermediate/
data/processed/

# --- Caches ---
.cache/
.requests_cache.sqlite
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# --- Environments / secrets ---
.venv/
venv/
*.env
.env
!.env.example

# --- Logs ---
logs/*
!logs/.gitkeep

# --- Build ---
*.egg-info/
build/
dist/

# --- OS ---
.DS_Store
Thumbs.db

# --- Tracked despite the rules above ---
!data/metadata/
!data/metadata/**
!tests/fixtures/
!tests/fixtures/**
!config/*.yaml
!**/.gitkeep

# ...but per-run manifests and timestamped validation reports are run logs,
# not reproducibility inputs (source_registry / schema_snapshots / dictionary
# stay tracked).
data/metadata/run_manifest/*.json
data/metadata/validation_report_*.json
!data/metadata/run_manifest/.gitkeep
